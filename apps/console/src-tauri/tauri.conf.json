{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nodeagent-console",
  "version": "2.0.0",
  "identifier": "cn.jkooe.nodeagent-console",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm sidecar:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nodeagent 控制台",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/sidecar.mjs": "sidecar.mjs"
    }
  }
}
