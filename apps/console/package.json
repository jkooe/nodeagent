{
  "name": "nodeagent-console",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar:dev": "node sidecar/main.mjs",
    "sidecar:build": "node sidecar/build.mjs",
    "prepare:node": "node ../../scripts/prepare-console.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "bundle": "pnpm sidecar:build && pnpm prepare:node && tauri build --config src-tauri/tauri.bundle.gen.json && pnpm verify:bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "echarts": "^6.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue-router": "^5.3.1",
    "@nodeagent/client": "workspace:*",
    "@nodeagent/protocol": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
