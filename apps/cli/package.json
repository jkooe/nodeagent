{
  "name": "@nodeagent/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "nodeagent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
