{
  "name": "nodeagent",
  "private": true,
  "version": "1.4.0",
  "description": "跨机 AI 接管框架 —— 让 Mac 上的 AI 无缝接管 Windows，装软件、查状态",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "agent": "pnpm --filter @nodeagent/agent start",
    "cli": "pnpm --filter @nodeagent/cli start",
    "mcp": "pnpm --filter @nodeagent/mcp start",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:windows": "node tests/e2e/windows.mjs",
    "verify": "node scripts/verify.mjs",
    "pack:win": "node scripts/pack.mjs",
    "pack:mac": "node scripts/pack-macos.mjs",
    "update:win": "node scripts/update-win.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
